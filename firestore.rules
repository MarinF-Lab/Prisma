rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Paletas destacadas: públicas para leer, solo editables desde la consola/admin
    match /curatedPalettes/{paletteId} {
      allow read: if true;
      allow write: if false;
    }

    // Librería de colores: pública para leer, solo editable desde la consola/admin
    match /colors/{colorId} {
      allow read: if true;
      allow write: if false;
    }

    // Paletas privadas de cada usuario
    match /users/{userId}/palettes/{paletteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
